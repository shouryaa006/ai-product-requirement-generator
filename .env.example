# Copy this file to .env and change values as needed.
# Never commit a real .env file.

APP_NAME=AI Product Requirement Generator
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Required for POST /api/v1/prd/generate
# Get a key from https://aistudio.google.com/apikey
# Never commit the real key.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. gemini-2.5-flash is the default for this project.
GEMINI_MODEL=gemini-2.5-flash

# RAG Configuration
RAG_TOP_K=5
RAG_PERSIST_DIRECTORY=data/chroma
